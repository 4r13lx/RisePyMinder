# RisePyMinder - Environment Configuration
# Copy this file to .env and complete with your values

# Timezone (IANA timezone identifier)
# Examples: UTC, America/New_York, America/Argentina/Buenos_Aires, Europe/London, Asia/Tokyo
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=UTC

# Default interval for scheduling (in seconds) - how often the scheduler checks for upcoming events
INTERVAL_SECONDS=3600

# Default minutes for time rounding (e.g., 60 for rounding to the nearest hour, 15 for quarter-hour, etc.)
TIME_ROUNDING_MINUTES=60

# Legacy default destinations. Used only by schedule entries without
# "recipient" or "recipients". Multiple Apprise URLs can be comma-separated.
# Supports any service compatible with Apprise:
# - Email: mailtos://user@gmail.com
# - Discord: discord://webhook_id/webhook_token
# - Telegram: tgram://bot_token/chat_id
# - Slack: slack://token_a/token_b/token_c
# - WhatsApp: twilio://account_sid:auth_token@from_number:to_number
# - And many more...

# Example legacy broadcast:
# RECIPIENTS=tgram://bot_token/chat_id_1,discord://webhook_id/webhook_token

# Named destinations: each name can point to one or more Apprise URLs.
# In schedule.json, use "recipient": "math" to send only to RECIPIENT_MATH.
# Names are case-insensitive and may contain letters, numbers, and underscores.
# Each Discord webhook URL targets the channel associated with that webhook.
# RECIPIENT_MATH=discord://MATH_CHANNEL_WEBHOOK_ID/MATH_CHANNEL_WEBHOOK_TOKEN
# RECIPIENT_HISTORY=discord://HISTORY_CHANNEL_WEBHOOK_ID/HISTORY_CHANNEL_WEBHOOK_TOKEN
# RECIPIENT_STAFF=discord://STAFF_CHANNEL_WEBHOOK_ID/STAFF_CHANNEL_WEBHOOK_TOKEN

# Optional legacy default; named recipients do not require this variable.
RECIPIENTS=
